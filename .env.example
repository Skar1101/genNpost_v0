# OpenAI
OPENAI_API_KEY=
# OpenRouter (Article Writer model selection — DeepSeek/Claude/GPT via one key).
# Optional: if unset, the Article Writer falls back to OPENAI_API_KEY (openai/* models only).
OPENROUTER_API_KEY=

# Twitter / X — via RapidAPI (twitter-api45.p.rapidapi.com, 1000 free/month)
RAPIDAPI_KEY=your_rapidapi_key_here

# YouTube
YOUTUBE_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_WEBHOOK_URL=   # for local dev; use real domain in prod
# Only needed if you switch from polling to webhook mode. Telegram sends this back in the
# X-Telegram-Bot-Api-Secret-Token header; verify it before trusting webhook requests.
TELEGRAM_WEBHOOK_SECRET=

# Heron's Telegram delivery (Substack drafts + hand-off only). Default (recommended): leave
# HERON_TELEGRAM_BOT_TOKEN and HERON_TELEGRAM_CHAT_ID both empty — Heron content merges straight into
# Titto's bot/chat above, so there's only ever ONE Telegram bot for you to talk to.
# Two opt-in alternatives if you want Heron content separated out:
#   1. Same bot, second chat: leave HERON_TELEGRAM_BOT_TOKEN empty, set HERON_TELEGRAM_CHAT_ID to a
#      second chat/channel your EXISTING bot (above) is also in. Still one bot identity, just a
#      second inbox. Don't know that chat's id? Add the bot to the group/channel, send /chatid
#      there, and it replies with the numeric id to paste in below.
#   2. Fully separate bot: create a second bot via @BotFather and set HERON_TELEGRAM_BOT_TOKEN too.
#      Only do this if you actually want a distinct bot identity for Heron.
HERON_TELEGRAM_BOT_TOKEN=
HERON_TELEGRAM_CHAT_ID=
HERON_TELEGRAM_WEBHOOK_URL=
HERON_TELEGRAM_WEBHOOK_SECRET=

# Parrot (LinkedIn) — the ONE agent in this app that actually auto-posts. Approve (in Telegram or the
# web Queue) posts to LinkedIn for real, immediately. Default (recommended): leave
# PARROT_TELEGRAM_BOT_TOKEN and PARROT_TELEGRAM_CHAT_ID both empty — LinkedIn drafts merge into
# Titto's bot/chat above too, with their own explicit "Approve & Post to LinkedIn" button so it's
# never confused with a plain draft-queue Approve. Same two opt-in alternatives as Heron above
# (second chat on the same bot, or a fully separate PARROT_TELEGRAM_BOT_TOKEN bot) if you want
# LinkedIn approvals kept somewhere else.
PARROT_TELEGRAM_BOT_TOKEN=
PARROT_TELEGRAM_CHAT_ID=
PARROT_TELEGRAM_WEBHOOK_URL=
PARROT_TELEGRAM_WEBHOOK_SECRET=

# LinkedIn API credentials (for Parrot's real posting). One-time setup:
#   1. Create an app at https://developer.linkedin.com (needs your own LinkedIn login — can't be
#      done on your behalf).
#   2. Add the "Sign In with LinkedIn using OpenID Connect" AND "Share on LinkedIn" products.
#   3. Copy the Client ID + Client Secret below.
#   4. Under Auth settings, add an Authorized redirect URL matching LINKEDIN_REDIRECT_URI
#      (default: http://localhost:<PORT>/api/parrot/oauth/callback).
#   5. Restart the server, then visit /api/parrot/oauth/start once in a browser to connect.
# LinkedIn tokens expire every ~60 days with NO silent refresh at this access tier — you'll need to
# repeat step 5 periodically (the dashboard/Telegram will warn you before it expires).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# ── Image generation ─────────────────────────────────────────────────────────
# Which API generates images. Leave EMPTY and the first provider below with a key wins, in this
# order: fal -> openrouter -> openai. Set it to force one: fal | openrouter | openai
# (A value naming a provider with no key is ignored, so a typo can't break generation.)
IMAGE_PROVIDER=
#
# fal.ai — cheapest per image (~$0.003) and the ONLY provider that can fine-tune, so a LoRA trained
# on your approved images needs this key. Optional.
FAL_KEY=
#
# OpenRouter uses OPENROUTER_API_KEY above (the same key the Article Writer uses). FLUX at
# ~$0.014-0.016 per image. OpenAI uses OPENAI_API_KEY and is the always-available fallback (~$0.04).
#
# To ADD a provider: drop a file in utils/imageProviders/ and list it in that folder's index.js.
# Nothing else in the codebase needs to change.

# Server
PORT=
# Network binding. Default 127.0.0.1 = localhost only (nothing on the LAN can reach the API).
# For a 24x7 public server deploy, set HOST=0.0.0.0 AND set API_TOKEN below to lock it down.
HOST=
# Optional shared-secret for the API. Leave EMPTY on localhost (no auth needed). When set,
# every /api/* request must send it as `Authorization: Bearer <token>`, `x-api-token`, or `?token=`.
API_TOKEN=
