# OpenAI
OPENAI_API_KEY=sk-...

# OpenRouter (Article Writer model selection — DeepSeek/Claude/GPT via one key).
# Optional: if unset, the Article Writer falls back to OPENAI_API_KEY (openai/* models only).
OPENROUTER_API_KEY=sk-or-...

# Twitter / X — via RapidAPI (twitter-api45.p.rapidapi.com, 1000 free/month)
RAPIDAPI_KEY=your_rapidapi_key_here

# YouTube
YOUTUBE_API_KEY=AIza...

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_WEBHOOK_URL=https://xxxx.ngrok.io   # for local dev; use real domain in prod

# Server
PORT=3000
